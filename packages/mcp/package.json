{
  "name": "@panelwave/mcp",
  "version": "0.1.0",
  "description": "Local MCP bridge for PanelWave: connects Claude Desktop, Claude Code, Cursor and other MCP clients to the hosted PanelWave MCP server and adds local file tools (list, read, upload a folder of panels).",
  "main": "dist/index.js",
  "bin": {
    "panelwave-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "panelwave",
    "mcp",
    "model-context-protocol",
    "graphic-novel",
    "claude"
  ],
  "license": "MIT",
  "homepage": "https://github.com/panelwave/packages/tree/master/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/panelwave/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panelwave/packages.git",
    "directory": "packages/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "image-size": "^2.0.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.4.0"
  }
}
